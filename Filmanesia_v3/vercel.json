{
  "routes": [
    {
      "src": "^/$",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "dest": "/index.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8" }
    },
    {
      "src": "/api/mcp",
      "dest": "/api/mcp.js"
    },
    {
      "src": "/.well-known/mcp/server-card.json",
      "headers": {
        "Content-Type": "application/mcp-server-card+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/sw.js",
      "headers": {
        "Content-Type": "application/javascript",
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/ai-catalog.json",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(movies|series)(/[^/]+){0,2}$",
      "dest": "/index.html"
    },
    {
      "src": "^/(movie|tv)/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/person/[^/]+/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/(search|watchlist|trending-film|blog)$",
      "dest": "/index.html"
    },
    {
      "src": "^/blog/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/jadwal-bioskop/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/(tentang|kontak|syarat-ketentuan)$",
      "dest": "/index.html"
    },
    {
      "src": "^/(film-terbaru|film-indonesia|film-netflix|film-horor|film-berdasarkan-genre|film-berdasarkan-tahun|review-film|jadwal-bioskop|film-yang-akan-datang|ending-explanation|rekomendasi-film)$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.filmanesia.com/index.md>; rel=\"alternate\"; type=\"text/markdown\", <https://www.filmanesia.com/llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/mcp-server-card+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "fullscreen=*, picture-in-picture=*, autoplay=*, encrypted-media=*, screen-wake-lock=*"
        },
        {
          "key": "Feature-Policy",
          "value": "fullscreen *; picture-in-picture *; autoplay *; encrypted-media *"
        }
      ]
    }
  ]
}
