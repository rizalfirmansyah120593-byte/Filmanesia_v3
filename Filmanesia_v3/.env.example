VITE_TMDB_API=your_tmdb_api_key
VITE_BASE_URL=https://api.themoviedb.org/3

# Supabase project URL dan anon public key.
VITE_SUPABASE_URL=https://project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# API artikel Filmanesia
VITE_ARTICLES_API_URL=https://filmanesia.com/api

# Hostinger Node.js automation (set these in hPanel)
ARTICLE_AUTOPUBLISH_ENABLED=true
OPENAI_ARTICLE_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key

# Optional article storage location. Hostinger defaults to ~/.filmanesia/data;
# local development uses data/articles.json.
# ARTICLE_DATA_DIR=/home/your-user/.filmanesia/data

# Optional automatic publishing to a Facebook Page.
# Create a Page access token with the required publishing permission in Meta.
FACEBOOK_AUTOPUBLISH_ENABLED=false
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_GRAPH_API_VERSION=v27.0
